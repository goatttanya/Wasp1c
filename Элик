<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Гонка за эликсиром - Тактика</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #1a1a1a;
            color: #e0e0e0;
            line-height: 1.6;
            margin: 0;
            padding: 0;
        }
        .container {
            max-width: 800px;
            margin: 20px auto;
            background-color: #262626;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
        }
        h1 {
            color: #ffcc00;
            text-align: center;
            border-bottom: 2px solid #ffcc00;
            padding-bottom: 10px;
            text-transform: uppercase;
        }
        h2 {
            color: #00ccff;
            margin-top: 30px;
            border-left: 5px solid #00ccff;
            padding-left: 10px;
        }
        h3 {
            color: #ff6666;
        }
        .time-alert {
            background-color: #3d3d1a;
            border: 1px solid #ffcc00;
            padding: 15px;
            border-radius: 5px;
            margin: 15px 0;
            font-weight: bold;
        }
        .important-block {
            background-color: #332222;
            border: 1px solid #ff4444;
            padding: 15px;
            border-radius: 5px;
            margin: 15px 0;
        }
        ul {
            padding-left: 20px;
        }
        li {
            margin-bottom: 10px;
        }
        .highlight {
            color: #ffcc00;
            font-weight: bold;
        }
        .blue-team {
            color: #3399ff;
            font-weight: bold;
        }
        .red-team {
            color: #ff3333;
            font-weight: bold;
        }
